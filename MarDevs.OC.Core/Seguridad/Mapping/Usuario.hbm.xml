<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2" default-cascade="none">
	<class name="Usuario" table="Usuario" lazy="false" batch-size="100">
		<cache usage="nonstrict-read-write"/>

		<id name="Id" column="UsuarioID" type="Int32" unsaved-value="null">
			<generator class="native"/>
		</id>
		<property name="Logon" column="UsuarioLogon" type="String" not-null="true" length="15" />
		<property name="Nombre" column="UsuarioNombre" type="String" length="25" />
		<property name="Apellido" column="UsuarioApellido" type="String" length="25" />
		<property name="Habilitado" column="UsuarioHabilitado" type="Boolean" not-null="true"/>
    <property name="Password" column="UsuarioPass" type="String" length="30" />
		<property name="FechaUltimoIngreso" column="FechaUltimoIngreso" type="DateTime" not-null="false" />
		<property name="FechaUltimoCambioPassword" column="FechaUltimoCambioPass" type="DateTime" not-null="false" />
		<property name="UsarVigenciaPasswordDefault" column="UsarVigenciaPassDefault" type="Boolean" not-null="true" access="field.pascalcase-m-underscore" />
		<property name="DiasVigenciaPassword" column="DiasVigenciaPass" type="Int32"/>

		<property name="CreadoEl" column="FechaDeCarga" type="System.DateTime" update="false"/>
		<many-to-one name="CreadoPor" class="UsuarioLight" column="UsuarioIdCarga" outer-join="false" cascade="none" update="false" />
		
		<component name="Telefono1" class="Telefono" >
			<property name="Tipo" column="Telefono1Tipo" type="String" />
			<property name="Numero" column="Telefono1Numero" type="String" />
		</component>
		
		<component name="Telefono2" class="Telefono" >
			<property name="Tipo" column="Telefono2Tipo" type="String" />
			<property name="Numero" column="Telefono2Numero" type="String" />
		</component>
		
		<property name="Email1" column="Email1" type="String"/>   


    <bag name="Roles" table="UsuarioRol" generic="true" cascade="none" lazy="true" batch-size="100" access="field.pascalcase-m-underscore" >
			<cache usage="read-write"/>
			<key column="UsuarioID"/>
			<many-to-many column="RolID" class="Rol" />
		</bag>

	</class>
</hibernate-mapping>
