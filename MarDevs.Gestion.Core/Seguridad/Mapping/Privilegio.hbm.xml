<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2" default-cascade="none">
	<class name="Privilegio" table="Privilegio" lazy="false">
	<cache usage="read-only"/>

		<id name="Id" column="PrivilegioID" type="Int32" unsaved-value="null" >
			<generator class="native"/>
		</id>
		<property name="Nombre" column="PrivilegioNombre" type="String" length="50" not-null="true" />
		<property name="Categoria" column="Categoria" type="String" length="50" not-null="true" />		
		
	</class>
</hibernate-mapping>
