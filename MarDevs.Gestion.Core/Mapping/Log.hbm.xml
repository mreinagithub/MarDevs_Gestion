<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2" default-cascade="save-update">
	<class name="Log" table="Log" lazy="false" >
		
		<id name="Id" column="LogId" type="Int32" unsaved-value="null" >
			<generator class="native"/>
		</id>

		<property name="EntidadTipo"	column="EntidadTipo"	type="String"	not-null="true" />
		<property name="EntidadId"		column="EntidadId"		type="String"	not-null="true" />
		<property name="Detalle"		column="Detalle"		type="String"   not-null="true" />
		<property name="Fecha"			column="Fecha"			type="DateTime" not-null="true" />
		
		<many-to-one name="Usuario" class="UsuarioLight" column="UsuarioId" outer-join="false" cascade="none" />
	</class>
</hibernate-mapping>
